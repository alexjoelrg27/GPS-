{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "serve.ps1",
      "*.md",
      "firestore.rules",
      ".firebaserc"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "cleanUrls": true
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
